<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget Theme for Android 12+ with Dynamic Colors -->
    <style name="Theme.Widget.Veritm" parent="@android:style/Theme.DeviceDefault.DayNight" />

    <style name="Theme.Veritm.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Veritm">
        <item name="android:windowSplashScreenBackground">#030D0B</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/veritm_logo_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#030D0B</item>
    </style>
</resources>
